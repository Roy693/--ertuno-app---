{
  "name": "ertuno",
  "description": "A tech-forward platform that blends secure backend architecture with frontend artistry",
  "version": "1.0.0",
  "homepage": "https://ertuno.com",
  "private": true,
  "type": "module",
  "keywords": [
    "collaboration",
    "creative",
    "platform",
    "react",
    "typescript",
    "firebase"
  ],
  "author": "ERTUNO Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ertuno.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist",
    "git:init": "git init && git add . && git commit -m 'Initial ERTUNO commit'",
    "git:commit": "git add . && git commit -m",
    "deploy:preview": "npm run build && echo 'Ready for deployment preview'",
    "deploy:production": "npm run build && echo 'Ready for production deployment'"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "firebase": "^12.3.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
